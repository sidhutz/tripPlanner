# Copy this file to .env.local and fill in your Supabase project values.
# Supabase dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# Optional. Server-only — never prefix this key with NEXT_PUBLIC_.
# The forms work with the publishable key alone because all writes go through
# `security definer` RPC functions. Set this only if you want the API routes to
# use full service-role access.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
